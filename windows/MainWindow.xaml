<Window x:Class="Yattalog.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="やったこと" Width="440" Height="650" WindowStartupLocation="CenterScreen" Background="#FAF8F6" Foreground="#302D30" FontFamily="Yu Gothic UI" FontSize="14">
 <Window.Resources>
  <Geometry x:Key="Logo">M3,5 L21,5 21,21 3,21 Z M3,9 H21 M7,2 V7 M17,2 V7 M7,14 L10,17 17,11</Geometry>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#563749"/><Setter Property="Padding" Value="8,4"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" CornerRadius="20" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.78"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton"><Setter Property="Padding" Value="12,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
   <Border x:Name="Tab" CornerRadius="16" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="#F0E7EB"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid x:Name="Form" Margin="20,12">
   <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
    <StackPanel MaxWidth="350" VerticalAlignment="Center" Margin="3,8">
     <Label Target="{Binding ElementName=TitleBox}" Content="やったこと" Padding="0,0,0,4"/>
     <Border BorderBrush="#B5A9AF" BorderThickness="0,0,0,1"><TextBox x:Name="TitleBox" FontSize="19" MaxLength="200" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Padding="0,4" AutomationProperties.Name="やったこと"/></Border>
     <DatePicker x:Name="Day" Margin="0,18,0,2" HorizontalAlignment="Center" SelectedDateChanged="DayChanged" AutomationProperties.Name="日付"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="−" Click="Earlier" Width="40" AutomationProperties.Name="5分戻す"/>
      <TextBlock x:Name="Clock" FontFamily="Segoe UI" FontSize="44" VerticalAlignment="Center" MouseWheel="ClockWheel"/>
      <Button Content="＋" Click="Later" Width="40" AutomationProperties.Name="5分進める"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,12">
      <RadioButton x:Name="Start" Content="始めた時間" Checked="AnchorChanged"/><RadioButton x:Name="End" Content="終わった時間" IsChecked="True" Checked="AnchorChanged"/>
     </StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock Text="所要時間" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" PreviewMouseWheel="DurationWheel">
       <Button x:Name="Before" Click="Shorter" Height="26" AutomationProperties.Name="所要時間を短くする"/>
       <Border CornerRadius="8" Background="#F0E7EB" Padding="0,5"><TextBlock x:Name="Duration" TextAlignment="Center" FontWeight="SemiBold"/></Border>
       <Button x:Name="After" Click="Longer" Height="26" AutomationProperties.Name="所要時間を長くする"/>
      </StackPanel>
     </Grid>
     <TextBlock x:Name="Range" TextAlignment="Center" Margin="0,12,0,0" Foreground="#665E63"/>
    </StackPanel>
   </ScrollViewer>
   <Button x:Name="FoldButton" Grid.Row="1" HorizontalAlignment="Right" Width="42" Height="42" Padding="10" Background="#74465B" Click="Fold" AutomationProperties.Name="待機タイルへ" ToolTip="待機タイルへ"><Path Data="{StaticResource Logo}" Stroke="White" StrokeThickness="2" Stretch="Uniform"/></Button>
  </Grid>
  <Grid x:Name="Tile" Visibility="Collapsed">
   <Button x:Name="OpenPanelButton" Click="OpenPanel" ToolTip="入力パネルを開く" AutomationProperties.Name="入力パネルを開く">
    <Border Width="52" Height="52" Background="#74465B" CornerRadius="26" Padding="14"><Path Data="{StaticResource Logo}" Stroke="White" StrokeThickness="2" Stretch="Uniform"/></Border>
   </Button>
   <Button x:Name="RestoreButton" Click="RestoreNormal" HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="32" Content="⤢" ToolTip="通常画面に戻る" AutomationProperties.Name="通常画面に戻る"/>
  </Grid>
 </Grid>
</Window>
